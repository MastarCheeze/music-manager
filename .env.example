HOST=127.0.0.1
PORT=8000
LIBRARY_PATH=./music  # Folder to store music files
DB_PATH=./music/downloads.db  # Path to .db file to keep track of downloaded files
DEEZER_ARL=  # Deezer ARL
# Format to save music files as
# See `track_format` field of https://github.com/nathom/streamrip/blob/e3291615ba6be34aa76df19da8aeb6f41673c6a0/streamrip/config.toml
TRACK_FILENAME_FORMAT={artist} - {title}